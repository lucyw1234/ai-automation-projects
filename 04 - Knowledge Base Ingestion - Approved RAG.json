    {
      "parameters": {
        "jsCode": "const results = [];\nconst items = $input.all();\nconst CHUNK_SIZE = 1400;\nconst OVERLAP = 180;\n\nfunction sanitize(text) {\n  let t = text || \"\";\n  t = t.replace(/\\0/g, \"\");\n  t = t.replace(/\\\\u(?![0-9a-fA-F]{4})/g, \"\\\\\\\\u\");\n  t = t.replace(/\\r\\n/g, \"\\n\");\n  t = t.replace(/\\n{4,}/g, \"\\n\\n\\n\");\n  return t.trim();\n}\n\nfunction splitIntoChunks(text) {\n  const paragraphs = text.split(/\\n{2,}/).map(p => p.trim()).filter(Boolean);\n  const chunks = [];\n  let current = \"\";\n\n  for (const p of paragraphs) {\n    if (!current) { current = p; continue; }\n\n    if ((current + \"\\n\\n\" + p).length <= CHUNK_SIZE) {\n      current += \"\\n\\n\" + p;\n      continue;\n    }\n\n    chunks.push(current.trim());\n    const tail = current.slice(Math.max(0, current.length - OVERLAP));\n    current = (tail + \"\\n\\n\" + p).trim();\n\n    while (current.length > CHUNK_SIZE) {\n      chunks.push(current.slice(0, CHUNK_SIZE).trim());\n      current = current.slice(Math.max(1, CHUNK_SIZE - OVERLAP)).trim();\n    }\n  }\n\n  if (current.trim()) chunks.push(current.trim());\n  return chunks.filter(c => c.length >= 20);\n}\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const docData = item.json || {};\n  let rawText = \"\";\n\n  if (item.binary && Object.keys(item.binary).length) {\n    const binaryKey = Object.keys(item.binary)[0];\n    const buffer = await this.helpers.getBinaryDataBuffer(i, binaryKey);\n    rawText = buffer.toString(\"utf8\");\n  } else {\n    rawText = docData.content || docData.text || docData.data || \"\";\n  }\n\n  const cleanedText = sanitize(rawText);\n  if (!cleanedText || cleanedText.length < 20) continue;\n\n  const binaryMeta = item.binary ? Object.values(item.binary)[0] : null;\n  const fileName = docData.name || binaryMeta?.fileName || \"unknown\";\n  const documentId = docData.id || docData.fileId || binaryMeta?.id || \"\";\n\n  const chunks = splitIntoChunks(cleanedText);\n\n  for (let chunkIndex = 0; chunkIndex < chunks.length; chunkIndex++) {\n    results.push({\n      json: {\n        text: chunks[chunkIndex],\n        metadata: {\n          document_id: documentId,\n          document_name: fileName,\n          chunk_index: chunkIndex,\n          chunk_count: chunks.length,\n          classification: \"stable_rag\",\n          approval_status: \"approved\",\n          source: \"Google Drive\",\n          source_folder: \"FLOWMATE KNOWLEDGE BASE\"\n        }\n      }\n    });\n  }\n}\n\nreturn results;"
      },
